+const CONTROLLER_HOSTS = ['gemini.google.com'];
+
+export function isControllerTab(tab?: chrome.tabs.Tab | null): boolean {
+  if (!tab?.url) return false;
+  try {
+    return CONTROLLER_HOSTS.includes(new URL(tab.url).hostname);
