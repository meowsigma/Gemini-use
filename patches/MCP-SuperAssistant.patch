+// Browser-agent mode: the chat tab is often in the background while tools act on other
+// tabs. Chromium pauses requestAnimationFrame in hidden tabs, which would stall the
+// execute → insert → submit loop, so fall back to timers while hidden.
+{
+  const nativeRAF = window.requestAnimationFrame.bind(window);
+  const nativeCAF = window.cancelAnimationFrame.bind(window);
+  window.requestAnimationFrame = (cb: FrameRequestCallback): number =>
+    document.hidden ? (window.setTimeout(() => cb(performance.now()), 16) as unknown as number) : nativeRAF(cb);
+  window.cancelAnimationFrame = (id: number) => {
+    nativeCAF(id);
+    window.clearTimeout(id);
+  };
+}
